+    audio_service_.PlaySound(Lang::Sounds::OGG_MAMA);
+    niulai_polite_intro_.Begin(esp_timer_get_time());
+    esp_err_t status = ESP_ERR_INVALID_STATE;
+    if (niulai_polite_timer_handle_ != nullptr) {
+        esp_timer_stop(niulai_polite_timer_handle_);
+        status = esp_timer_start_once(niulai_polite_timer_handle_, 2200000);
+    }
+    if (status != ESP_OK) {
+        ESP_LOGW(TAG, "Niulai: intro timer failed: %s", esp_err_to_name(status));
+        CancelNiulaiPoliteChat();
+    }
+}
+
+void Application::CancelNiulaiPoliteChat() {
+    niulai_cloud_reply_enabled_ = false;
+    niulai_reply_generation_.fetch_add(1);
+    bool pending = niulai_polite_intro_.Pending();
+    niulai_polite_intro_.Cancel();
+    if (niulai_polite_timer_handle_ != nullptr) {
+        esp_timer_stop(niulai_polite_timer_handle_);
+    }
+    xEventGroupClearBits(event_group_, MAIN_EVENT_NIULAI_POLITE_READY);
+    if (pending) {
+        audio_service_.ResetDecoder();
+        audio_service_.EnableWakeWordDetection(true);
+    }
+}
+
+bool Application::CanAcceptCloudReply(uint32_t generation) const {
+    return !IsNiulaiBoard() || niulai_polite_intro_.AcceptCloudReply(
+        niulai_cloud_reply_enabled_, generation, niulai_reply_generation_.load());
+}
+
+void Application::EnableNiulaiCloudReplies() {
+    if (!niulai_cloud_reply_enabled_) {
+        // Discard callbacks queued while the intro/connection was still blocked.
+        niulai_reply_generation_.fetch_add(1);
+        niulai_cloud_reply_enabled_ = true;
+    }
+}
